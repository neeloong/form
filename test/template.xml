<ul +a=1>
	<input !value=int />
	<li !value="a" !enum>
		<input !value=b />
		<ul>
			<li !value="c" !enum +b=1>
			<button @click="a+=1">a+1:<span !fragment !text=a></span></button>
			<button @click="b+=1">b+1:<span !fragment !text=b></span></button>
				<div !fragment !text="$no"/>. <div !fragment !text="d">1</div> <div !fragment !text>1</div>
			</li>
			<li !value="x" !enum +b=x$length +a=2>
				<button @click="a+=1">a+1:<span !fragment !text=a></span></button>
				<button @click="b+=1">b+1:<span !fragment !text=b></span></button>
				<div !fragment !text="$no"/>. <div !fragment !text="d">1</div> <div !fragment !text>1</div>
			</li>
		</ul>
	</li>
</ul>
<ul>
	<input !value=int />
	<li !value="a" !enum>
		<input !value=b />
		<ul>
			<li !value="c" !enum>
				<input !value=d />
				<input !value />
			</li>
			<li !value="x" !enum>
				<input !value=d />
				<input !value />
			</li>
		</ul>
	</li>
</ul>
