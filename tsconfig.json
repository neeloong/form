{
  "compilerOptions": {
    "module": "ESNext",
    "target": "esnext",
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "outDir": "./typings",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
		"verbatimModuleSyntax": true,
    "esModuleInterop": true
  },
  "locale": "zh-CN",
  "include": ["src"],
  "compileOnSave": true
}
